---
// A real capture or a short film of FriRSS, 16:9. See src/config/media.ts.
// The still is lazy-loaded; the film loads nothing until the visitor presses play.
import { Image, getImage } from 'astro:assets';
import { asset, type Dictionary } from '../i18n';
import { productFilm } from '../config/media';
import posterFr from '../assets/media/film-poster-fr.webp';
import posterEn from '../assets/media/film-poster-en.webp';
interface Props {
  t: Dictionary;
  lang: string;
}
const { t, lang } = Astro.props;
const poster = lang === 'fr' ? posterFr : posterEn;
const { mp4, webm, width, height } = productFilm;
const frame = mp4 ? await getImage({ src: poster, width, format: 'webp' }) : null;
---

<figure class="film" data-reveal="lift">
  {frame ? (
    <video
      controls
      preload="none"
      playsinline
      width={width}
      height={height}
      poster={frame.src}
      aria-label={t.features.film.alt}
    >
      {webm && <source src={asset(webm)} type="video/webm" />}
      <source src={asset(mp4)} type="video/mp4" />
    </video>
  ) : (
    <Image
      src={poster}
      alt={t.features.film.alt}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="(max-width: 1440px) calc(100vw - 48px), 1280px"
      loading="lazy"
      decoding="async"
    />
  )}
  <figcaption>{t.features.film.caption}</figcaption>
</figure>
