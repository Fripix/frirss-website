---
// The installation guide has its own route so it loads only the new design system.
import Layout from '../../layouts/Layout.astro';
import Installation from '../../components/Installation.astro';
import { languages, dictionary } from '../../i18n';
export function getStaticPaths() {
  return languages.map((language) => ({
    params: { lang: language.code, getStarted: dictionary(language.code).seo.getStarted.slug },
  }));
}
const lang = Astro.params.lang!;
const t = dictionary(lang);
---

<Layout lang={lang} page="getStarted">
  <Installation t={t} />
</Layout>
