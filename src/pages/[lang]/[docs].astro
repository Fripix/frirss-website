---
// Resources has its own route so it loads only the new design system.
import Layout from '../../layouts/Layout.astro';
import Resources from '../../components/Resources.astro';
import { languages, dictionary } from '../../i18n';
export function getStaticPaths() {
  return languages.map((language) => ({
    params: { lang: language.code, docs: dictionary(language.code).seo.docs.slug },
  }));
}
const lang = Astro.params.lang!;
const t = dictionary(lang);
---

<Layout lang={lang} page="docs">
  <Resources t={t} lang={lang} />
</Layout>
